# ─────────────────────────────────────────────────────────────────────────────
# Sonaro Gate • 2025.1 LTS  —  Production Environment
# GitHub: https://github.com/huynhtrungcsc/sonaro-gate
# Copy to .env and fill in all values before production deployment
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain & TLS ───────────────────────────────
DOMAIN=firewall.example.com
CERTBOT_EMAIL=admin@example.com

# ── Database (CHANGE THESE!) ───────────────────
POSTGRES_DB=sonaro_gate
POSTGRES_USER=sonaro
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD_HERE

# ── JWT Secret (min 32 chars, CHANGE THIS!) ────
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ── Application ────────────────────────────────
PORT=5000
NODE_ENV=production
SONARO_SKIP_SETUP=1

# ── Backup ─────────────────────────────────────
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *
