# ─────────────────────────────────────────────────────────────────────────────
# Sonaro Gate • 2025.1 LTS  —  Docker Environment Variables
# GitHub: https://github.com/huynhtrungcsc/sonaro-gate
# Copy to .env and update all values before running docker compose
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=sonaro_gate
POSTGRES_USER=sonaro
POSTGRES_PASSWORD=changeme_in_production!

# JWT Secret (min 32 chars — generate: openssl rand -hex 32)
JWT_SECRET=replace-with-openssl-rand-hex-32-output

# Web server port
PORT=5000
