# ─────────────────────────────────────────────────────────────────────────────
# Sonaro Gate • 2025.1 LTS  —  Environment Variables
# GitHub: https://github.com/huynhtrungcsc/sonaro-gate
#
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit .env to version control (it is in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=sonaro_gate
POSTGRES_USER=sonaro
# REQUIRED — generate a strong password:
#   openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24

# ── Application ───────────────────────────────────────────────────────────────
# Full connection string (built from the vars above in docker-compose)
# Only set manually for native (non-Docker) deployments:
DATABASE_URL=postgresql://sonaro:CHANGE_ME@localhost:5432/sonaro_gate

# JWT secret — MUST be at least 32 random characters
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Web server port (default: 5000)
PORT=5000

# Node environment
NODE_ENV=production

# ── First-boot wizard ─────────────────────────────────────────────────────────
# Set to "1" to skip the interactive CLI setup wizard.
# Leave empty on bare-metal installations so the wizard can assign
# WAN / LAN / DMZ interfaces via the terminal before first web login.
# The installer (deploy/install.sh) sets this automatically.
SONARO_SKIP_SETUP=

# ── Admin seed (only used on first database initialisation) ──────────────────
ADMIN_EMAIL=admin@sonaro.local
# IMPORTANT: Change this immediately after first login.
ADMIN_PASSWORD=Admin123!

# ── Optional: HTTPS / TLS (when using deploy/nginx-ssl.conf) ─────────────────
# Your publicly resolvable domain name — required for Let's Encrypt.
DOMAIN=firewall.example.com
# Email for Let's Encrypt expiry notifications:
CERTBOT_EMAIL=admin@example.com
