# ─────────────────────────────────────────────────────────────────────────────
# Sonaro Gate • 2025.1 LTS  —  Environment Variables
# GitHub: https://github.com/huynhtrungcsc/sonaro-gate
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=sonaro_gate
POSTGRES_USER=sonaro
POSTGRES_PASSWORD=changeme_please_use_strong_password!

# ── Application ───────────────────────────────────────────────────────────────
# Full PostgreSQL connection string (used by the Node.js backend)
DATABASE_URL=postgresql://sonaro:changeme_please_use_strong_password!@localhost:5432/sonaro_gate

# JWT secret — MUST be at least 32 random characters
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32

# Web server port
PORT=5000

# Node environment
NODE_ENV=production

# ── Wizard control ────────────────────────────────────────────────────────────
# Set to "1" to skip the first-boot CLI setup wizard (Docker / headless)
# Leave empty or unset for bare-metal Ubuntu deployment (wizard will run)
SONARO_SKIP_SETUP=

# ── Admin seed (used only on first database initialization) ──────────────────
ADMIN_EMAIL=admin@sonaro.local
ADMIN_PASSWORD=Admin123!
